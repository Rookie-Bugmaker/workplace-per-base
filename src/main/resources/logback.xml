<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 1. TraceID转换规则（必须放在最前） -->
    <conversionRule conversionWord="tid"
                    converterClass="org.apache.skywalking.apm.toolkit.log.logback.v1.x.LogbackPatternConverter"/>

    <!-- 2. 基础属性 -->
    <property name="SERVICE_NAME" value="workplace-per-self"/>
    <property name="LOG_HOME" value="/var/log/workplace-new"/>

    <!-- 3. 优化后的日志模式（已修复换行问题） -->
    <!-- 控制台专用带颜色版本 -->
    <property name="HIGHLIGHT_PATTERN"
              value="%yellow(%d{yyyy-MM-dd HH:mm:ss.SSS}) [%blue(%tid)] [%magenta(${SERVICE_NAME})] [%thread] %highlight(%-5level) %green(%logger{30}) - %msg%n%ex{5}"/>

    <!-- 文件输出简洁版本 -->
    <property name="TRACE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%tid] [${SERVICE_NAME}] [%thread] %-5level %logger{30} - %msg%n%ex{5}"/>

    <!-- 4. 控制台输出优化 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${HIGHLIGHT_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>

    <!-- 5. 文件滚动输出（生产环境） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${SERVICE_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${SERVICE_NAME}-%d{yyyy-MM-dd}-%i.log.zip</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
            <maxFileSize>100MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>${TRACE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 6. SkyWalking gRPC日志上报 -->
    <appender name="GRPC_LOG" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder>
            <!-- JSON格式便于SkyWalking分析 -->
            <pattern>
                {
                "timestamp":"%d{yyyy-MM-dd HH:mm:ss.SSS}",
                "trace_id":"%tid",
                "service":"${SERVICE_NAME}",
                "level":"%level",
                "thread":"%thread",
                "logger":"%logger",
                "message":"%message",
                "exception":"%exception"
                }
            </pattern>
        </encoder>
    </appender>

    <!-- 7. 异步日志包装（提升性能） -->
    <appender name="ASYNC_GRPC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="GRPC_LOG"/>
    </appender>

    <!-- 8. 日志级别控制 -->
    <logger name="org.apache.skywalking" level="WARN" additivity="false"/>
    <logger name="com.crrc" level="INFO"/>

    <!-- 9. 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ASYNC_GRPC"/>
    </root>

</configuration>